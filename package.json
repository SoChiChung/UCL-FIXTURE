{
  "name": "ucl-fantasy-fixture-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "normalize": "node scripts/normalize-fixtures.mjs",
    "fetch:cards": "node scripts/fetch-cards.mjs",
    "verify": "esbuild scripts/verify-logic.mjs --bundle --platform=node --format=esm --outfile=scripts/.verify.mjs --external:react --external:react-dom && node scripts/patch-verify.mjs && node scripts/.verify.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
